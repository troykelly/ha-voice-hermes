#!/usr/bin/env bash
set -Eeuo pipefail

if [[ -e /tmp/ha-voice-hermes/certificate-degraded ||
      -L /tmp/ha-voice-hermes/certificate-degraded ]]; then
  echo "gateway certificate source is degraded" >&2
  exit 1
fi

exec curl \
  --noproxy '*' \
  --proto '=https' \
  --insecure \
  --fail \
  --silent \
  --show-error \
  --max-time 3 \
  https://127.0.0.1:8443/healthz
