#!/usr/bin/env bash
set -Eeuo pipefail

umask 077

readonly RUNTIME_ROOT="/tmp/ha-voice-hermes"
readonly OPTIONS_ROOT="/data"
readonly CERTIFICATE_ROOT="/ssl"
readonly SNAPSHOT="/usr/local/bin/secure-snapshot"
readonly VALIDATOR="/usr/local/bin/validate-options.jq"
readonly GATEWAY_ROOT="/opt/ha-voice-hermes/gateway"

die() {
  printf '%s\n' "Gateway configuration could not be prepared: $1" >&2
  exit "${2:-1}"
}

if [[ $# -ne 1 ]]; then
  die "one generation directory is required"
fi

generation="$1"
case "$generation" in
  "$RUNTIME_ROOT"/generation.*|"$RUNTIME_ROOT"/probe.*) ;;
  *) die "the generation directory is outside the runtime root" ;;
esac

if [[ ! -d "$generation" || -L "$generation" ]]; then
  die "the generation directory is not a regular directory"
fi
if [[ "$(stat -c '%u:%g:%a' "$generation")" != "0:0:700" ]]; then
  die "the generation directory has unsafe ownership or permissions"
fi

readonly bindings="$generation/bindings"
install -d -m 0700 -o root -g root "$bindings"

if ! "$SNAPSHOT" "$OPTIONS_ROOT" "options.json" "$generation" "options.json" 1048576; then
  die "Home Assistant options could not be read safely" 20
fi

if ! jq -e -f "$VALIDATOR" "$generation/options.json" >"$generation/normalized.json"; then
  die "Home Assistant options failed validation" 20
fi
chmod 0400 "$generation/normalized.json"

# Materialize this before reading TLS files. The supervisor uses it to
# distinguish an incomplete certificate renewal from a simultaneous option
# change that must stop the active process so revoked credentials cannot linger.
sha256sum "$generation/normalized.json" | cut -d' ' -f1 \
  >"$generation/options-fingerprint"
chmod 0400 "$generation/options-fingerprint"

certfile="$(jq -j '.certfile' "$generation/normalized.json")"
keyfile="$(jq -j '.keyfile' "$generation/normalized.json")"
if ! "$SNAPSHOT" "$CERTIFICATE_ROOT" "$certfile" "$generation" "server-chain.pem" 1048576; then
  die "certfile could not be read safely" 21
fi
if ! "$SNAPSHOT" "$CERTIFICATE_ROOT" "$keyfile" "$generation" "server-key.pem" 1048576; then
  die "keyfile could not be read safely" 21
fi

if ! openssl crl2pkcs7 -nocrl -certfile "$generation/server-chain.pem" 2>/dev/null |
    openssl pkcs7 -print_certs -noout >/dev/null 2>&1; then
  die "certfile is not a valid PEM certificate chain" 21
fi
if ! openssl x509 -in "$generation/server-chain.pem" -noout >/dev/null 2>&1; then
  die "certfile does not begin with an X.509 leaf certificate" 21
fi
if ! openssl verify \
    -purpose sslserver \
    -CAfile /etc/ssl/certs/ca-certificates.crt \
    -untrusted "$generation/server-chain.pem" \
    "$generation/server-chain.pem" >/dev/null 2>&1; then
  die "certfile does not form a server chain to a public CA trusted by the App" 21
fi
if ! openssl pkey -in "$generation/server-key.pem" -passin pass: -check -noout >/dev/null 2>&1; then
  die "keyfile is not a supported unencrypted private key" 21
fi

not_before="$(openssl x509 -in "$generation/server-chain.pem" -noout -startdate 2>/dev/null)" ||
  die "the certificate start date could not be read" 21
not_after="$(openssl x509 -in "$generation/server-chain.pem" -noout -enddate 2>/dev/null)" ||
  die "the certificate expiry date could not be read" 21
not_before_epoch="$(date --date="${not_before#notBefore=}" +%s 2>/dev/null)" ||
  die "the certificate start date is invalid" 21
not_after_epoch="$(date --date="${not_after#notAfter=}" +%s 2>/dev/null)" ||
  die "the certificate expiry date is invalid" 21
now_epoch="$(date +%s)"
if (( now_epoch < not_before_epoch || now_epoch >= not_after_epoch )); then
  die "the certificate is not currently valid" 21
fi
printf '%s\n' "$not_after_epoch" >"$generation/certificate-not-after"
chmod 0400 "$generation/certificate-not-after"

certificate_public_key="$(
  openssl x509 -in "$generation/server-chain.pem" -pubkey -noout 2>/dev/null |
    openssl pkey -pubin -outform DER 2>/dev/null |
    sha256sum | cut -d' ' -f1
)" || die "the certificate public key could not be read" 21
private_public_key="$(
  openssl pkey -in "$generation/server-key.pem" -passin pass: -pubout -outform DER 2>/dev/null |
    sha256sum | cut -d' ' -f1
)" || die "the private key public key could not be read" 21
if [[ -z "$certificate_public_key" || "$certificate_public_key" != "$private_public_key" ]]; then
  die "certfile and keyfile do not match" 21
fi

write_binding() {
  local name="$1"
  local filter="$2"
  jq -j "$filter" "$generation/normalized.json" >"$bindings/$name"
  chmod 0400 "$bindings/$name"
}

write_binding "DEVICE_TOKENS_JSON" '[.devices[] | {key: .device_id, value: .device_token}] | from_entries | tojson'
write_binding "HERMES_SESSION_KEYS_JSON" '[.devices[] | {key: .device_id, value: .hermes_session_key}] | from_entries | tojson'
write_binding "STT_PROVIDER" '"elevenlabs"'
write_binding "ELEVENLABS_API_KEY" '.elevenlabs_api_key'
write_binding "ELEVENLABS_VOICE_ID" '.elevenlabs_voice_id'
write_binding "REALTIME_STT_MODEL" '.realtime_stt_model'
write_binding "TTS_MODEL" '.tts_model'
write_binding "ELEVENLABS_ENABLE_LOGGING" '.elevenlabs_enable_logging | tostring'
write_binding "STT_LANGUAGE_CODE" '.stt_language_code'
write_binding "HERMES_BASE_URL" '.hermes_base_url'
write_binding "HERMES_API_KEY" '.hermes_api_key'
write_binding "HERMES_MODEL" '.hermes_model'
write_binding "HERMES_PROFILE_ID" '.hermes_profile_id'
write_binding "HERMES_BINDING_REVISION" '.hermes_binding_revision'
write_binding "HERMES_VOICE_INSTRUCTIONS" '.hermes_voice_instructions'
write_binding "CONVERSATION_IDLE_SECONDS" '.conversation_idle_seconds | tostring'
write_binding "CF_ACCESS_CLIENT_ID" '.cf_access_client_id'
write_binding "CF_ACCESS_CLIENT_SECRET" '.cf_access_client_secret'
write_binding "REALTIME_MAX_AUDIO_SECONDS" '.realtime_max_audio_seconds | tostring'
write_binding "REALTIME_MAX_OUTPUT_SECONDS" '.realtime_max_output_seconds | tostring'
write_binding "MAX_CONNECTION_AUDIO_SECONDS" '.max_connection_audio_seconds | tostring'
write_binding "MAX_TURNS_PER_CONNECTION" '.max_turns_per_connection | tostring'
write_binding "MAX_MESSAGES_PER_CONNECTION" '.max_messages_per_connection | tostring'
write_binding "DIAGNOSTIC_V1_ENABLED" '.diagnostic_v1_enabled | tostring'

network_allow='["public"]'
if [[ "$(jq -j '.allow_private_upstreams' "$generation/normalized.json")" == "true" ]]; then
  network_allow='["public", "private"]'
fi

binding_config=""
for binding_file in "$bindings"/*; do
  binding_name="${binding_file##*/}"
  binding_config+="        (name = \"$binding_name\", text = embed \"$binding_file\"),"$'\n'
done

cat >"$generation/config.capnp" <<EOF
using Workerd = import "/workerd/workerd.capnp";

const config :Workerd.Config = (
  services = [
    (name = "main", worker = (
      modules = [
        (name = "index.js", esModule = embed "$GATEWAY_ROOT/index.js"),
        (name = "index_bg.wasm", wasm = embed "$GATEWAY_ROOT/index_bg.wasm")
      ],
      compatibilityDate = "2026-07-11",
      compatibilityFlags = ["no_websocket_standard_binary_type"],
      bindings = [
        (name = "VOICE_SESSIONS", durableObjectNamespace = "VoiceSession"),
${binding_config%,$'\n'}
      ],
      durableObjectNamespaces = [
        (className = "VoiceSession",
         uniqueKey = "com.github.troykelly.ha-voice-hermes.VoiceSession.local.v1",
         enableSql = true)
      ],
      durableObjectStorage = (localDisk = "storage")
    )),
    (name = "storage", disk = (path = "/data/workerd", writable = true)),
    (name = "internet", network = (
      allow = $network_allow,
      deny = ["local"],
      tlsOptions = (trustBrowserCas = true)
    ))
  ],
  sockets = [
    (name = "https", address = "*:8443", https = (
      options = (),
      tlsOptions = (
        keypair = (
          privateKey = embed "$generation/server-key.pem",
          certificateChain = embed "$generation/server-chain.pem"
        ),
        minVersion = tls1Dot2
      )
    ), service = "main")
  ]
);
EOF
chmod 0400 "$generation/config.capnp"

hash_file() {
  sha256sum "$1" | cut -d' ' -f1
}

{
  hash_file "$generation/normalized.json"
  hash_file "$generation/server-chain.pem"
  hash_file "$generation/server-key.pem"
  hash_file "$GATEWAY_ROOT/index.js"
  hash_file "$GATEWAY_ROOT/index_bg.wasm"
} | sha256sum | cut -d' ' -f1 >"$generation/fingerprint"
jq -j '.certificate_poll_seconds | tostring' "$generation/normalized.json" \
  >"$generation/poll-seconds"
chmod 0400 \
  "$generation/certificate-not-after" \
  "$generation/fingerprint" \
  "$generation/poll-seconds"

# Keep completed probes root-only. The supervisor hands ownership to the
# unprivileged runtime only after it selects a stable generation and stops the
# previous workerd process. This prevents an active compromised runtime from
# reading replacement credentials while they are merely being polled.
