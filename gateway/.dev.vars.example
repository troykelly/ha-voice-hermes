# Copy to .dev.vars for local development. Never commit real values.
# Per-device credentials are required by default. Keep these device IDs aligned
# and replace every value before starting the Worker.
DEVICE_TOKENS_JSON='{"voice-pe-REPLACE_ME":"REPLACE_ME"}'
HERMES_SESSION_KEYS_JSON='{"voice-pe-REPLACE_ME":"agent:main:voice:device:voice-pe-REPLACE_ME"}'
ELEVENLABS_API_KEY="REPLACE_ME"
ELEVENLABS_VOICE_ID="REPLACE_ME"
HERMES_BASE_URL="https://hermes.example.com"
HERMES_API_KEY="REPLACE_ME"

# Secure default is 15 minutes. Set a room-appropriate explicit boundary.
CONVERSATION_IDLE_SECONDS="900"
# Decoded realtime reply audio is hard-bounded to 1-30 seconds per turn.
REALTIME_MAX_OUTPUT_SECONDS="30"

# Stable agent/profile fence. Increment the revision when SOUL, tools, sandbox,
# memory policy, or another behavior-defining profile property changes.
HERMES_PROFILE_ID="voice-safe"
HERMES_BINDING_REVISION="v1"

# Optional Cloudflare Access service token protecting HERMES_BASE_URL.
# CF_ACCESS_CLIENT_ID="service-token-id.access"
# CF_ACCESS_CLIENT_SECRET="REPLACE_ME"

# OpenAI-compatible STT fallback:
# STT_PROVIDER="openai-compatible"
# STT_BASE_URL="https://api.openai.com/v1"
# STT_API_KEY="REPLACE_ME"
# STT_MODEL="whisper-1"
